enum Pog_Nodekind {
    ERROR;
    Expr_Plus;
    Expr_Minus;
    Expr_Mul;
    Expr_Div;
    Expr_Mod;

    Expr_Range;

    Expr_Less;
    Expr_Greater;
    Expr_LessEquals;
    Expr_GreaterEquals;
    Expr_Equals;
    Expr_NotEquals;

    Expr_And;
    Expr_Or;

    Expr_Bit_And;
    Expr_Bit_Or;
    Expr_Bit_Xor;
    Expr_Bit_Lshift;
    Expr_Bit_Rshift;

    Expr_PreIncrement;
    Expr_PostIncrement;
    Expr_PreDecrement;
    Expr_PostDecrement;

    Expr_Not;
    Expr_Bit_Not;
    Expr_AddressOf;
    Expr_ValueOf;
    Expr_Negate;

    Expr_Integer;
    Expr_Decimal;
    Expr_Char;
    Expr_String;
    Expr_True;
    Expr_False;
    Expr_Null;

    Expr_Variable;
    Expr_Alloc;
    Expr_Ternary;
    Expr_ProcCall;
    Expr_Deref;
    Expr_Indexing;
    Expr_Cast;
    Expr_Sizeof;
    Expr_Parenthesized;
    Expr_Compound;

    Stmt_Declaration;
    Stmt_Constant;
    Stmt_Typedef;
    Stmt_Procedure;
    Stmt_Argument;
    Stmt_Struct;
    Stmt_Enum;
    Stmt_EnumEntry;
    Stmt_Assignment;
    Stmt_Scope;
    Stmt_If;
    Stmt_While;
    Stmt_For;
    Stmt_Switch;
    Stmt_Continue;
    Stmt_Break;
    Stmt_Return;
    Stmt_Goto;
    Stmt_Label;
    Stmt_Case;
    Stmt_Default;
    Stmt_Include;

    Type_MustInfer;
    Type_Basic;
    Type_Procedure;
    Type_Array;
    Type_Fixed_Array;
    Type_Dynamic_Array;

}

