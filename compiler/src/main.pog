float32 test() {
    float32 v = MyPi * (2 + 3);

    if v < 0 {
        let n = null;
    }

    static char* message = "Hello, Seamen!\n";

    let c = message;
    while true {
        if @c;
        else break;

        switch @c {
            case 'l': goto done;
            default: c++; continue;
        }

        done:
        c++;
    }

    return v;
}

