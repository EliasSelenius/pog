


struct COFF_File_Header {
    uint16 Machine;              // The number that identifies the type of target machine. For more information, one of Image_File_Machine
    uint16 NumberOfSections;     // The number of sections. This indicates the size of the section table, which immediately follows the headers.
    uint32 TimeDateStamp;        // The low 32 bits of the number of seconds since 00:00 January 1, 1970 (a C run-time time_t value), which indicates when the file was created.
    uint32 PointerToSymbolTable; // The file offset of the COFF symbol table, or zero if no COFF symbol table is present. This value should be zero for an image because COFF debugging information is deprecated.
    uint32 NumberOfSymbols;      // The number of entries in the symbol table. This data can be used to locate the string table, which immediately follows the symbol table. This value should be zero for an image because COFF debugging information is deprecated.
    uint16 SizeOfOptionalHeader; // The size of the optional header, which is required for executable files but not for object files. This value should be zero for an object file. For a description of the header format, see Optional Header (Image Only).
    uint16 Characteristics;      // The flags that indicate the attributes of the file. For specific flag values, see Characteristics.
}

enum Image_File_Machine {
    UNKNOWN     = 0x0;    // The content of this field is assumed to be applicable to any machine type
    ALPHA       = 0x184;  // Alpha AXP, 32-bit address space
    ALPHA64     = 0x284;  // Alpha 64, 64-bit address space
    AM33        = 0x1d3;  // Matsushita AM33
    AMD64       = 0x8664; // x64
    ARM         = 0x1c0;  // ARM little endian
    ARM64       = 0xaa64; // ARM64 little endian
    ARM64EC     = 0xA641; // ABI that enables interoperability between native ARM64 and emulated x64 code.
    ARM64X      = 0xA64E; // Binary format that allows both native ARM64 and ARM64EC code to coexist in the same file.
    ARMNT       = 0x1c4;  // ARM Thumb-2 little endian
    AXP64       = 0x284;  // AXP 64 (Same as Alpha 64)
    EBC         = 0xebc;  // EFI byte code
    I386        = 0x14c;  // Intel 386 or later processors and compatible processors
    IA64        = 0x200;  // Intel Itanium processor family
    LOONGARCH32 = 0x6232; // LoongArch 32-bit processor family
    LOONGARCH64 = 0x6264; // LoongArch 64-bit processor family
    M32R        = 0x9041; // Mitsubishi M32R little endian
    MIPS16      = 0x266;  // MIPS16
    MIPSFPU     = 0x366;  // MIPS with FPU
    MIPSFPU16   = 0x466;  // MIPS16 with FPU
    POWERPC     = 0x1f0;  // Power PC little endian
    POWERPCFP   = 0x1f1;  // Power PC with floating point support
    R3000BE     = 0x160;  // MIPS I compatible 32-bit big endian
    R3000       = 0x162;  // MIPS I compatible 32-bit little endian
    R4000       = 0x166;  // MIPS III compatible 64-bit little endian
    R10000      = 0x168;  // MIPS IV compatible 64-bit little endian
    RISCV32     = 0x5032; // RISC-V 32-bit address space
    RISCV64     = 0x5064; // RISC-V 64-bit address space
    RISCV128    = 0x5128; // RISC-V 128-bit address space
    SH3         = 0x1a2;  // Hitachi SH3
    SH3DSP      = 0x1a3;  // Hitachi SH3 DSP
    SH4         = 0x1a6;  // Hitachi SH4
    SH5         = 0x1a8;  // Hitachi SH5
    THUMB       = 0x1c2;  // Thumb
    WCEMIPSV2   = 0x169;  // MIPS little-endian WCE v2
}

struct Image_Nt_Headers {
    uint32 signature;
    COFF_File_Header file_header;
    Image_Optional_Header_64 optional_header;
}

const Image_Optional_Header_Magic_Nr_PE32     = 0x10b; // for PE32
const Image_Optional_Header_Magic_Nr_PE32plus = 0x20b; // for PE32+
struct Image_Optional_Header_64 {
    uint16 Magic;
    uint8  MajorLinkerVersion;
    uint8  MinorLinkerVersion;
    uint32 SizeOfCode;
    uint32 SizeOfInitializedData;
    uint32 SizeOfUninitializedData;
    uint32 AddressOfEntryPoint;
    uint32 BaseOfCode;
    uint64 ImageBase;
    uint32 SectionAlignment;
    uint32 FileAlignment;
    uint16 MajorOperatingSystemVersion;
    uint16 MinorOperatingSystemVersion;
    uint16 MajorImageVersion;
    uint16 MinorImageVersion;
    uint16 MajorSubsystemVersion;
    uint16 MinorSubsystemVersion;
    uint32 Win32VersionValue;
    uint32 SizeOfImage;
    uint32 SizeOfHeaders;
    uint32 CheckSum;
    uint16 Subsystem;
    uint16 DllCharacteristics;
    uint64 SizeOfStackReserve;
    uint64 SizeOfStackCommit;
    uint64 SizeOfHeapReserve;
    uint64 SizeOfHeapCommit;
    uint32 LoaderFlags;
    uint32 NumberOfRvaAndSizes;
    Image_Data_Directory[Image_Numberof_Directory_Entries] DataDirectory;
}

const Image_Numberof_Directory_Entries = 16;
struct Image_Data_Directory {
    uint32 VirtualAddress;
    uint32 Size;
}

const Image_Directory_Entry_Export          =  0;   // Export Directory
const Image_Directory_Entry_Import          =  1;   // Import Directory
const Image_Directory_Entry_Resource        =  2;   // Resource Directory
const Image_Directory_Entry_Exception       =  3;   // Exception Directory
const Image_Directory_Entry_Security        =  4;   // Security Directory
const Image_Directory_Entry_Basereloc       =  5;   // Base Relocation Table
const Image_Directory_Entry_Debug           =  6;   // Debug Directory
const Image_Directory_Entry_Architecture    =  7;   // Architecture Specific Data
const Image_Directory_Entry_Globalptr       =  8;   // RVA of GP
const Image_Directory_Entry_TLS             =  9;   // TLS Directory
const Image_Directory_Entry_Load_config     = 10;   // Load Configuration Directory
const Image_Directory_Entry_Bound_import    = 11;   // Bound Import Directory in headers
const Image_Directory_Entry_IAT             = 12;   // Import Address Table
const Image_Directory_Entry_Delay_import    = 13;   // Delay Load Import Descriptors
const Image_Directory_Entry_COM_descriptor  = 14;   // COM Runtime descriptor

struct Image_Section_Header {
    char[8] Name;

    // union {
    //         uint32   PhysicalAddress;
    //         uint32   VirtualSize;
    // } Misc;
    uint32 PhysicalAddress_VirtualSize; // I dont support unions yet

    uint32 VirtualAddress;
    uint32 SizeOfRawData;
    uint32 PointerToRawData;
    uint32 PointerToRelocations;
    uint32 PointerToLinenumbers;
    uint16 NumberOfRelocations;
    uint16 NumberOfLinenumbers;
    uint32 Characteristics;
}

struct Image_Import_Descriptor {
    // union {
    //     dword   Characteristics;
    //     dword   OriginalFirstThunk;
    // } dummyunionname;

    uint32 OriginalFirstThunk; // RVA to import lookup table (ILT)
    uint32 TimeDateStamp;
    uint32 ForwarderChain;
    uint32 Name; // RVA to name
    uint32 FirstThunk; // RVA to import address table (IAT)
}

struct PE32 {
    byte* ptr;
    Image_Nt_Headers* nt_headers;
    Image_Section_Header[] section_headers;
}

uint64 offset_from_rva(PE32* pe, uint64 rva) {
    for 0 .. pe.section_headers.length {
        let sec = pe.section_headers[it];
        if sec.VirtualAddress <= rva
        if rva < sec.VirtualAddress + sec.SizeOfRawData {
            return sec.PointerToRawData + (rva - sec.VirtualAddress);
        }
    }

    return rva;
}

PE32 read_pe32(char* filename) {
    byte[] bytes = read_binary_file(filename);
    byte* ptr = bytes.data;

    uint32 file_addr_of_new_exe_header = @(*bytes[0x3c] as uint32*);

    Image_Nt_Headers* nt_headers = ptr + file_addr_of_new_exe_header;
    COFF_File_Header* coff_header = *nt_headers.file_header;
    Image_Optional_Header_64* opt_header = *nt_headers.optional_header;

    Image_Section_Header* sec_header = ptr + file_addr_of_new_exe_header + sizeof Image_Nt_Headers;

    Image_Section_Header[] section_headers;
    section_headers.data   = sec_header;
    section_headers.length = nt_headers.file_header.NumberOfSections;

    PE32 pe = {};
    pe.ptr = ptr;
    pe.nt_headers = nt_headers;
    pe.section_headers = section_headers;




    uint64 imports = offset_from_rva(*pe, opt_header.DataDirectory[Image_Directory_Entry_Import].VirtualAddress)
    Image_Import_Descriptor* import_desc = ptr + imports;

    while true {
        Image_Import_Descriptor zero = {};
        if memcmp(import_desc, *zero, sizeof Image_Import_Descriptor) == 0 break;

        char* name = ptr + offset_from_rva(*pe, import_desc.Name);

        print("import descriptor:\n");
        printf("    OriginalFirstThunk: %x\n", import_desc.OriginalFirstThunk);
        printf("    TimeDateStamp     : %x\n", import_desc.TimeDateStamp);
        printf("    ForwarderChain    : %x\n", import_desc.ForwarderChain);
        printf("    Name              : %x (%s)\n", import_desc.Name, import_desc.Name == 0 ? "" : name);
        printf("    FirstThunk        : %x\n", import_desc.FirstThunk);

        uint64* ILT = ptr + offset_from_rva(*pe, import_desc.OriginalFirstThunk);
        uint64* i = ILT;
        while true {
            uint64 value = @i++;
            if value == 0 break;

            let is_ordinal = value & 0x8000_0000_0000_0000;
            if is_ordinal {
                uint16 ordinal = value as uint16;
            } else {
                uint64 hint_name_rva = value & 0x0000_0000_7fff_ffff;
                uint64 ofs = offset_from_rva(*pe, hint_name_rva);
                uint16 hint = @((ptr + ofs) as uint16*);
                char*  name = ptr + ofs + 2;
                printf("        %hx \"%s\"\n", hint, name);
            }

        }

        import_desc++;
    }

    return pe;
}

void print_pe32(PE32* pe) {
    print("NT Headers: ", sizeof Image_Nt_Headers, "\n");

    char* magicnr_PE = (*pe.nt_headers.signature) as char*;
    print("Magic Nr.: ", magicnr_PE[0], magicnr_PE[1], magicnr_PE[2], magicnr_PE[3], "\n");

    print("coff_header:", sizeof COFF_File_Header, "\n");
    print("    Machine             : ", pe.nt_headers.file_header.Machine, "\n");
    print("    NumberOfSections    : ", pe.nt_headers.file_header.NumberOfSections, "\n");
    print("    TimeDateStamp       : ", pe.nt_headers.file_header.TimeDateStamp, "\n");
    print("    PointerToSymbolTable: ", pe.nt_headers.file_header.PointerToSymbolTable, "\n");
    print("    NumberOfSymbols     : ", pe.nt_headers.file_header.NumberOfSymbols, "\n");
    print("    SizeOfOptionalHeader: ", pe.nt_headers.file_header.SizeOfOptionalHeader, "\n");
    print("    Characteristics     : ", pe.nt_headers.file_header.Characteristics, "\n");

    let opt_header = pe.nt_headers.optional_header;

    print("optional_header:", sizeof Image_Optional_Header_64, "\n");
    printf("    Magic                      : %hx\n", opt_header.Magic);
    print("    MajorLinkerVersion         : ", opt_header.MajorLinkerVersion as uint32, "\n");
    print("    MinorLinkerVersion         : ", opt_header.MinorLinkerVersion as uint32, "\n");
    print("    SizeOfCode                 : ", opt_header.SizeOfCode, "\n");
    print("    SizeOfInitializedData      : ", opt_header.SizeOfInitializedData, "\n");
    print("    SizeOfUninitializedData    : ", opt_header.SizeOfUninitializedData, "\n");
    print("    AddressOfEntryPoint        : ", opt_header.AddressOfEntryPoint, "\n");
    print("    BaseOfCode                 : ", opt_header.BaseOfCode, "\n");
    print("    ImageBase                  : ", opt_header.ImageBase, "\n");
    print("    SectionAlignment           : ", opt_header.SectionAlignment, "\n");
    print("    FileAlignment              : ", opt_header.FileAlignment, "\n");
    print("    MajorOperatingSystemVersion: ", opt_header.MajorOperatingSystemVersion, "\n");
    print("    MinorOperatingSystemVersion: ", opt_header.MinorOperatingSystemVersion, "\n");
    print("    MajorImageVersion          : ", opt_header.MajorImageVersion, "\n");
    print("    MinorImageVersion          : ", opt_header.MinorImageVersion, "\n");
    print("    MajorSubsystemVersion      : ", opt_header.MajorSubsystemVersion, "\n");
    print("    MinorSubsystemVersion      : ", opt_header.MinorSubsystemVersion, "\n");
    print("    Win32VersionValue          : ", opt_header.Win32VersionValue, "\n");
    print("    SizeOfImage                : ", opt_header.SizeOfImage, "\n");
    print("    SizeOfHeaders              : ", opt_header.SizeOfHeaders, "\n");
    print("    CheckSum                   : ", opt_header.CheckSum, "\n");
    print("    Subsystem                  : ", opt_header.Subsystem, "\n");
    print("    DllCharacteristics         : ", opt_header.DllCharacteristics, "\n");
    print("    SizeOfStackReserve         : ", opt_header.SizeOfStackReserve, "\n");
    print("    SizeOfStackCommit          : ", opt_header.SizeOfStackCommit, "\n");
    print("    SizeOfHeapReserve          : ", opt_header.SizeOfHeapReserve, "\n");
    print("    SizeOfHeapCommit           : ", opt_header.SizeOfHeapCommit, "\n");
    print("    LoaderFlags                : ", opt_header.LoaderFlags, "\n");
    print("    NumberOfRvaAndSizes        : ", opt_header.NumberOfRvaAndSizes, "\n");

    char*[Image_Numberof_Directory_Entries] directory_entry_names = {
        "Export", "Import", "Resource", "Exception",
        "Security", "Basereloc", "Debug", "Architecture",
        "Globalptr", "TLS", "Load_config", "Bound_import",
        "IAT", "Delay_import", "COM_descriptor",
    };

    print("    DataDirectory: (VirtualAddress, Size)\n");
    for 0 .. Image_Numberof_Directory_Entries {
        let entry = opt_header.DataDirectory[it];
        printf("        %02d. %-15s: %8x, %8x\n", it, directory_entry_names[it], entry.VirtualAddress, entry.Size);
    }

    for 0 .. pe.section_headers.length {
        let sec = pe.section_headers[it];
        print("Section Header\n");
        print("    Name                       : ", sec.Name as char*, "\n");
        printf("    PhysicalAddress_VirtualSize: %x\n", sec.PhysicalAddress_VirtualSize);
        printf("    VirtualAddress             : %x\n", sec.VirtualAddress);
        printf("    SizeOfRawData              : %x\n", sec.SizeOfRawData);
        printf("    PointerToRawData           : %x\n", sec.PointerToRawData);
        printf("    PointerToRelocations       : %x\n", sec.PointerToRelocations);
        printf("    PointerToLinenumbers       : %x\n", sec.PointerToLinenumbers);
        print("    NumberOfRelocations        : ", sec.NumberOfRelocations, "\n");
        print("    NumberOfLinenumbers        : ", sec.NumberOfLinenumbers, "\n");
        print("    Characteristics            : ", sec.Characteristics, "\n");
    }
}