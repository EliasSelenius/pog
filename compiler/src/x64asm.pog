uint32 decode_instruction(byte* start_ptr, x64_Instruction* inst) {

    // deafults for 64bit mode
    uint32 opsize = 4; // operand bytesize // TODO: some opcodes are marked d64 meaning it defaults to 64bit opsize
    uint32 adsize = 8; // address bytesize

    byte* ptr = start_ptr;

    // TODO: incorporate this with x64_opcode_operation lookup table like we do with REX prefixes
    switch (@ptr) { // TODO: check for other prefixes...
        case 0x64: ptr++; break;
        case 0x65: ptr++; break;
        case 0x66: ptr++; opsize = 2; break;
        case 0x67: ptr++; adsize = 4; break;
    }

    byte opcode = @ptr;
    x64_Operation op = x64_opcode_operation[opcode];

    byte bit_ext_reg = 0;
    byte bit_ext_idx = 0;
    byte bit_ext_mem = 0;

    if op == .REX {
        if opcode & 0b1000   opsize = 8;
        bit_ext_reg = (@ptr & 0b0100) << 1;
        bit_ext_idx = (@ptr & 0b0010) << 2;
        bit_ext_mem = (@ptr & 0b0001) << 3;

        ptr++;
        opcode = @ptr;
        op = x64_opcode_operation[opcode];
    }

    // TODO: opcode = 0F (2-byte escape)

    byte modrm_byte_present = x64_opcode_modrm[opcode];
    if modrm_byte_present {
        ModRM_SIB_disp m = {};
        ptr = modrm(++ptr, *m);

        m.reg |= bit_ext_reg;
        m.idx |= bit_ext_idx;
        m.mem |= bit_ext_mem;
    }

    x64_Operand op1 = {kind=.Register, reg=reg_from_index(m.reg, opsize)};
    x64_Operand op2 = {};
    if m.mem_is_register   op2 = {kind=.Register, reg=reg_from_index(m.mem, opsize)}
    else                   op2 = {kind=.Memory,   reg=reg_from_index(m.mem, adsize), index=reg_from_index(m.idx, adsize), scale=m.scale, imm_value=m.disp as int64};


    uint32 imm_bytes = x64_opcode_imm_bytes[opcode];
    if imm_bytes {
        
    }

}

struct ModRM_SIB_disp {
    byte reg;
    byte mem;
    byte idx;
    bool mem_is_register;
    uint32 scale;
    int32 disp;
}

byte* modrm(byte* ptr, ModRM_SIB_disp* m) {
    byte mod_reg_rm = @ptr;
    byte mod = (mod_reg_rm & 0b11000000) >> 6;
    byte reg = (mod_reg_rm & 0b00111000) >> 3; // TODO: reg may be an opcode extension
    byte rm  = (mod_reg_rm & 0b00000111) >> 0;

    @m = {
        reg = reg,
        mem = rm
    };


    uint32 disp_bytes = 0;

    switch mod {
        case 0b00: {
            if rm == 0b101 { // RIP relative addressing
                disp_bytes = 4;
                mem_op.reg = .rip;
            }
        } break;
        case 0b01: disp_bytes = 1; break; // one byte signed displacement
        case 0b10: disp_bytes = 4; break; // four byte signed displacement
        case 0b11: { // rm is a register, not an address
            mem_op.kind = .Register;
            m.mem_is_register = true;
            return ptr;
        } break;
    }

    if rm == 0b100 { // SIB
        byte sib = @(++ptr);
        byte ss    = (sib & 0b11000000) >> 6;
        byte index = (sib & 0b00111000) >> 3;
        byte base  = (sib & 0b00000111) >> 0;

        m.scale = 1 << ss;
        if (index == 0b100) m.scale = 0;

        m.mem = base;
        m.idx = index;
    }

    switch (disp_bytes) {
        case 0: break;
        case 1:
            m.disp = @(++ptr) as int32;
            break;
        case 4:
            m.disp = @(++ptr as uint32*) as int32;
            ptr+= 4;
            break;
        default: break;
    }

    return ptr;
}