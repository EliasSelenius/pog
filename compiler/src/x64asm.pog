    /*D0*/    .NONE,    .NONE,    .NONE,    .NONE,    .NONE,    .NONE,    .NONE,    .NONE,    .ESC,     .ESC,     .ESC,     .ESC,     .ESC,     .ESC,     .ESC,     .ESC,
