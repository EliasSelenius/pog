uint32 decode_instruction(byte* start_ptr, x64_Instruction* inst) {

    // deafults for 64bit mode
    uint32 operand_bytesize = 4;
    uint32 address_bytesize = 8;

    byte* ptr = start_ptr;

    // TODO: incorporate this with x64_opcode_operation lookup table like we do with REX prefixes
    switch (@ptr) { // TODO: check for other prefixes...
        case 0x64: ptr++; break;
        case 0x65: ptr++; break;
        case 0x66: ptr++; operand_bytesize = 2; break;
        case 0x67: ptr++; address_bytesize = 4; break;
    }

    x64_Operation op = x64_opcode_operation[@ptr];

    if op == .REX {
        if @ptr & 0b1000   operand_bytesize = 8;
        byte bit_ext_reg = (@ptr & 0b0100) << 1;
        byte bit_ext_idx = (@ptr & 0b0010) << 2;
        byte bit_ext_mem = (@ptr & 0b0001) << 3;

        ptr++;
        op = x64_opcode_operation[@ptr];
    }


}

x64_Operand modrm(byte* ptr) {

    x64_Operand operand = {kind=.Memory};


    byte mod_reg_rm = ptr[0];
    byte mod = (mod_reg_rm & 0b11000000) >> 6;
    byte reg = (mod_reg_rm & 0b00111000) >> 3;
    byte rm  = (mod_reg_rm & 0b00000111) >> 0;

    switch mod {
        case 00: break;
        case 01: break;
        case 10: break;
        case 11: {

        } break;
    }

    /*
        mod:
            case 00: no displacement
                unless rm == 101 then four byte signed displacement only (or RIP relative addressing in 64bit mode)
            case 01: one byte signed displacement
            case 10: four byte signed displacement
            case 11: rm is a register, not an address

        rm == 100 then SIB byte present
    */

    if rm == 0b100 {
        byte sib = ptr[1];
        byte ss    = (sib & 0b11000000) >> 6;
        byte index = (sib & 0b00111000) >> 3;
        byte base  = (sib & 0b00000111) >> 0;

        operand.scale = ({1,2,4,8} as uint32[])[ss];
        if (index == 0b100) operand.scale = 0;

        operand.reg   = base  as x64_Register;
        operand.index = index as x64_Register;
    }
}