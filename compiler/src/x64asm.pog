enum x64_Register {
    none=0;
    al;  cl;  dl;  bl;  ah;  ch;  dh;  bh;  r8b; r9b; r10b; r11b; r12b; r13b; r14b; r15b; // byte
    ax;  cx;  dx;  bx;  sp;  bp;  si;  di;  r8w; r9w; r10w; r11w; r12w; r13w; r14w; r15w; // word
    eax; ecx; edx; ebx; esp; ebp; esi; edi; r8d; r9d; r10d; r11d; r12d; r13d; r14d; r15d; // dword
    rax; rcx; rdx; rbx; rsp; rbp; rsi; rdi; r8;  r9;  r10;  r11;  r12;  r13;  r14;  r15;  // qword
    rip;
    eflags; rflags;
}

char* to_string(x64_Register reg) {
    char*[] strs = {
        "none",
        "al",  "cl",  "dl",  "bl",  "ah",  "ch",  "dh",  "bh",  "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b", // byte
        "ax",  "cx",  "dx",  "bx",  "sp",  "bp",  "si",  "di",  "r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w", // word
        "eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d", // dword
        "rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8",  "r9",  "r10",  "r11",  "r12",  "r13",  "r14",  "r15",  // qword
        "rip",
        "eflags", "rflags",
    };

    return strs[reg];
}

// select general purpose register
x64_Register select_gpr(byte index, uint32 bytesize) {
    switch bytesize {
        case 1: return .al  + index;
        case 2: return .ax  + index;
        case 4: return .eax + index;
        case 8: return .rax + index;
        default: break;
    }

    return .none;
}

const x64_Instruction_Max_Operands = 4;

struct x64_Instruction {
    x64_Operation operation;
    x64_Operand[x64_Instruction_Max_Operands] operands;
}

enum x64_Operand_Kind {
    None;
    Immediate; // op.imm_value
    Register;  // op.reg
    Memory;    // ptr [op.reg + op.index*op.scale + op.imm_value]
}

struct x64_Operand {
    x64_Operand_Kind kind;
    x64_Register reg;
    x64_Register index;
    uint32 scale;
    int64 imm_value; // immediate or displacement
    uint32 opsize;
}

/* legend:
    Eb,Gb    Ev,Gv    Gb,Eb    Gv,Ev    AL,Ib    rAX,Iz

    E       = ModRM.rm field
    G       = ModRM.reg field
    AL      = the AL register
    I       = Immediate value
    rAX     = either AX, EAX or RAX depending on operand-size
    S       = the ModRM.reg field selects a segment register
    M       = The ModR/M byte may refer only to memory

    b       = a byte
    w       = a word
    d       = a doubleword
    q       = a quadword
    dq      = a double quadword
    qq      = a quad quadword

    v       = either word, doubleword or quadword depending on operand-size
    z       = either word (when 16bit operand-size) or doubleword (when 32/64bit operand-size)
    y       = either doubleword or quadword depending on operand-size
*/

const Eb   = 1;  // modrm.rm
const Ew   = 2;  // modrm.rm
const Ev   = 3;  // modrm.rm
const Gb   = 4;  // modrm.reg
const Gv   = 5;  // modrm.reg
const AL   = 6;  // AL byte register
const eAX  = 7;  // AX or EAX register (depending on operand-size)
const rAX  = 8;  // AX, EAX or RAX register (depending on operand-size)
const colb = 9;  // opcode.reg selects a byte register
const colv = 10; // opcode.reg selects a word/dword/qword register (depending on operand-size)
const Ib   = 11; // 1 byte immediate
const Iw   = 12; // 2 byte immediate
const Iz   = 13; // 2 or 4 byte immediate
const Iv   = 14; // 2/4/8 byte immediate
const Yb   = 15; // Memory addressed by the ES:rDI register pair
const Yz   = 16; // Memory addressed by the ES:rDI register pair
const Yv   = 17; // Memory addressed by the ES:rDI register pair
const DX   = 18; // DX word register
const Jb   = 19; // immediate byte is a relative offset to be added to the instruction pointer register
const Jz   = 20; // immediate word/dword is a relative offset to be added to the instruction pointer register
const Sw   = 21; // modrm.reg selects a segment register
const Fv   = 22; // EFLAGS or RFLAGS register
const Ob   = 23; // 4/8 bytes (address-size) of displacement after opcode. No modrm byte
const Ov   = 24; // 4/8 bytes (address-size) of displacement after opcode. No modrm byte
const Xb   = 25; // Memory addressed by the DS:rSI register pair
const Xz   = 26; // Memory addressed by the DS:rSI register pair
const Xv   = 27; // Memory addressed by the DS:rSI register pair
const esc  = 28; // 
const I1   = 29; // the constant 1
const M    = 30; // the ModR/M byte may refer only to memory
const CL   = 31; // CL byte register
const Cd   = 32; // modrm.reg selects control register
const Dd   = 33; // modrm.reg selects debug register
const Rd   = 34; // modrm.rm may refer only to a general register
const Ey   = 35; // modrm.rm
const FS   = 36; //
const GS   = 37; //
const Mp   = 38; //
const My   = 39; //
const Gy   = 40; // modrm.reg

struct x64_Opcode_Map_Entry {
    x64_Operation operation;
    byte[x64_Instruction_Max_Operands] operands;
    uint32 grp;
}

