    test({0xe8, 0x10, 0x00, 0x00, 0x00} as byte[], "call 0x10");

    test({0x8A, 0x04, 0x25, 0x01, 0x00, 0x00, 0x00} as byte[], "mov al, byte ptr ds:0x1");

    // this would be a cool hex array literal: 0x(66 41 97)
    //                             instead of: {0x66, 0x41, 0x97} as byte[]


    printf("Summary: %d/%d tests passed. Failed: %d\n", total_test_count - total_failed, total_test_count, total_failed);

}