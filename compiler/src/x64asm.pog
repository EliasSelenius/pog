    /*A0*/    .MOV,     .MOV,     .MOV,     .MOV,     .NONE,    .NONE,    .NONE,    .NONE,    .TEST,    .TEST,    .NONE,    .NONE,    .NONE,    .NONE,    .NONE,    .NONE,
