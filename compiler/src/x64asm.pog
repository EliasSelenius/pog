
enum x64_Operation {
    none;
    add; or; adc; sbb; and; sub; xor; cmp; rex; push; pop;
    movsxd; imul;
    Jcc;
    test; xchg; mov; lea; shaf; lahf;
    ret; enter; leave; int3; int;
    esc; loop;
    in; out; call; jmp; int1; hlt; cmc; clc; stc; cli; sti; cld; std;
    ins; outs;

    lar;
    lsl;
    syscall;
    clts;
    sysret;
    invd;
    wbinvd;
    prefetchw;
    wrmsr;
    rdtsc;
    rdmsr;
    rdpmc;
    sysenter;
    sysexit;
    getsec;
    cmov_cc;
    vmread;
    vmwrite;
    set_cc;
    cpuid;
    bt;
    shld;
    rsm;
    bts;
    shrd;
    cmpxchg;
    lss;
    btr;
    lfs;
    lgs;
    movzx;
    btc;
    bsf;
    bsr;
    movsx;
    xadd;
    movnti;
    bswap;
    ud0;

    prefix; // temp
}



