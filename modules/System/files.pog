
// include "../plang/common/windows.pog";

enum FileKind {
    file; folder; symlink;
}

struct FileInfo {
    uint64 bytesize;
    FileKind file_kind;
    string full_path;
    string dir, name, ext;
}

void enumerate_directory(string dir_path, void(FileInfo, void*) callback, void* user_ptr) {
    char* query = concat(dir_path, "\\*");

    WIN32_FIND_DATAA data = {};
    HANDLE handle = FindFirstFileA(query, *data);

    // HANDLE handle = FindFirstFileA(query, *data);
    // for bool l = true, l, l = FindNextFileA(handle, *data) {
    // }

    loop: {
        let error = GetLastError();
        switch error {
            case ERROR_SUCCESS: break;
            case ERROR_FILE_NOT_FOUND: goto done;
            case ERROR_PATH_NOT_FOUND: goto done;
            default: goto done;
        }

        char* file_name = data.cFileName as char*;

        if string_equals(file_name, ".")
        or string_equals(file_name, "..");
        else {
            FileInfo info = {};
            info.file_kind = data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY ? .folder : .file;
            info.bytesize  = (data.nFileSizeHigh as uint64 << 32) | data.nFileSizeLow;

            info.full_path = concat_path(dir_path, make_string(file_name));
            decompose_path(info.full_path, *info.dir, *info.name, *info.ext);

            callback(info, user_ptr);
        }
    } if FindNextFileA(handle, *data) goto loop;

    done:
    FindClose(handle);
}

// TODO: option to resue existing list
FileInfo[..] enumerate_directory(string dir_path) {
    void append_fileinfo(FileInfo info, void* user_ptr) {
        info.full_path = alloc_string_copy(info.full_path);
        decompose_path(info.full_path, *info.dir, *info.name, *info.ext);

        let list = user_ptr as FileInfo[..]*;
        list_add(list, *info);
    }

    FileInfo[..] list = list_create(sizeof FileInfo);
    enumerate_directory(dir_path, append_fileinfo, *list as void*);
    return list;
}

string get_full_path(char* filename) return get_full_path(filename, null);
string get_full_path(char* filename, string* out_name) {
    uint32 len = GetFullPathNameA(filename, 0, null, null);
    string str = {};
    // str.length = len-1;
    str.chars = malloc(len);

    char* name;
    str.length = GetFullPathNameA(filename, len, str.chars, *name);
    if out_name {
        @out_name = make_string(name);
    }

    return str;
}

string get_cwd() {
    let len = GetCurrentDirectoryA(0, null);
    string str = {};
    str.length = len-1;
    str.chars = malloc(len);
    GetCurrentDirectoryA(len, str.chars);
    return str;
}

string concat_path(string path1, path2) {
    bool is_path_separator(char c) return c == '\\' or c == '/';

    if is_path_separator(path1.chars[path1.length-1])  path1 = trim_end(path1, 1);
    if is_path_separator(path2.chars[0])               path2 = trim_start(path2, 1);

    return make_string(concat(path1, make_string("/"), path2));
}

void decompose_path(string full_path, string* dir, file) {
    decompose_path(full_path, dir, file, null);
}

void decompose_path(string full_path, string* dir, file, ext) {
    string case1 = substr_to_end(full_path, '\\');
    string case2 = substr_to_end(full_path, '/');
    string f = trim_start(case1.length < case2.length ? case1 : case2, 1);
    string e = trim_start(substr_to_end(f, '.'), 1);

    if ext   @ext  = e;
    if file  @file = trim_end(f, e.length);
    if dir   @dir  = trim_end(full_path, f.length + e.length);
}

