
enum Json_Token_Type {
    Null;
    False;
    True;
    String;
    Number;
    Obj_Begin;           // {
    Obj_End;             // }
    List_Begin;          // [
    List_End;            // ]
    Key_Value_Seperator; // :
    List_Seperator;      // ,
    EOF;
}

struct Json_Token {
    Json_Token_Type token_type;
    string str;
}

Json_Token json_token(char** input) {
    again: Token token = get_next_token(@input);
    @input += token.text.length;

    switch token.kind {
        case .unknown:         goto again;
        case .whitespace:      goto again;
        case .comment:         goto again;
    }

    Json_Token json = {};
    json.str = token.text;

    if token.kind == .punctuation {
        switch (token.text.chars[0]) {
            case '{': json.token_type = .Obj_Begin;           break;
            case '}': json.token_type = .Obj_End;             break;
            case '[': json.token_type = .List_Begin;          break;
            case ']': json.token_type = .List_End;            break;
            case ':': json.token_type = .Key_Value_Seperator; break;
            case ',': json.token_type = .List_Seperator;      break;
        }
    }

    if token.kind == .end_of_input {
        json.token_type = .EOF;
    }

    if token.kind == .integer
    or token.kind == .decimal {
        json.token_type = .Number;
    }

    if token.kind == .string_literal {
        json.token_type = .String;
    }

    if token.kind == .word {
        if string_equals(token.text, make_string("null"))  json.token_type = .Null;
        if string_equals(token.text, make_string("true"))  json.token_type = .True;
        if string_equals(token.text, make_string("false")) json.token_type = .False;
    }

    return json;
}

Json_Token json_peak(char** json) {
    char* input = @json;
    return json_token(*input);
}



enum JsonValue { Error; Null; Number; Bool; String; Object; List; }
struct Json {
    Json[..] keys;   // objects
    Json[..] values; // objects, lists
    float64 number;
    JsonValue json_type;
    string str;      // for strings, or for error message if json_type = .Error
    bool boolean;
}

Json json_value(char** json) {
    Json_Token token = json_token(json);
    switch (token.token_type) {
        case .Null:   return { json_type = .Null };
        case .False:  return { json_type = .Bool, boolean = false };
        case .True:   return { json_type = .Bool, boolean = true  };
        case .String: return { json_type = .String, str = trim(token.str, 1)};
        case .Number: return { json_type = .Number, number = parse_float(token.str.chars)};

        case .Obj_Begin: {
            Json json_obj = { json_type = .Object };
            json_obj.keys   = list_create(sizeof Json);
            json_obj.values = list_create(sizeof Json);

            while true {
                token = json_peak(json);

                if token.token_type == .Obj_End
                or token.token_type == .EOF {
                    json_token(json);
                    break;
                }

                Json key = json_value(json);

                token = json_peak(json);
                if token.token_type == .Key_Value_Seperator {
                    json_token(json);
                } else {
                    // error...
                }

                Json value = json_value(json);

                list_add(*json_obj.keys,   *key);
                list_add(*json_obj.values, *value);

                token = json_peak(json);
                if token.token_type == .List_Seperator {
                    json_token(json);
                } else {
                    // error...
                }
            }

            return json_obj;
        }

        case .List_Begin: {
            Json json_list = { json_type = .List };
            json_list.values = list_create(sizeof Json);

            while true {
                token = json_peak(json);

                if token.token_type == .List_End
                or token.token_type == .EOF {
                    json_token(json);
                    break;
                }

                Json value = json_value(json);
                list_add(*json_list.values, *value);

                token = json_peak(json);
                if token.token_type == .List_Seperator {
                    json_token(json);
                } else {
                    // error...
                }
            }

            return json_list;
        }

        case .Obj_End:             break;
        case .List_End:            break;
        case .Key_Value_Seperator: break;
        case .List_Seperator:      break;
        case .EOF:                 break;
    }

    return { json_type = .Error, str = make_string("Invalid JSON") };
}

Json json_parse(char* json) {

    // char* cursor = json;
    // uint32 it = 0;
    // while it < 20 {
    //     Json_Token token = json_token(*cursor);
    //     print(token.token_type, ": ", token.str, "\n");
    //     it++;
    //     if token.token_type == .EOF break;
    // }

    return json_value(*json);
}

void json_stringify(StringBuilder* sb, Json json) {
    switch (json.json_type) {
        case .Error: break;
        case .Null:   sb_append(sb, "null"); break;
        case .Number: sb_append(sb, json.number as float32); break; // TODO: truncation...
        case .Bool:   sb_append(sb, json.boolean ? "true" : "false"); break;
        case .String: sb_append(sb, "\""); sb_append(sb, json.str); sb_append(sb, "\""); break;

        case .Object: {
            sb_append(sb, "{");
            uint32 len = list_length(json.keys);
            for 0 .. len {
                json_stringify(sb, json.keys[it]);
                sb_append(sb, ":");
                json_stringify(sb, json.values[it]);
                if it != len-1  sb_append(sb, ",");
            }
            sb_append(sb, "}");
        } break;

        case .List: {
            sb_append(sb, "[");
            uint32 len = list_length(json.values);
            for 0 .. len {
                json_stringify(sb, json.values[it]);
                if it != len-1  sb_append(sb, ",");
            }
            sb_append(sb, "]");
        } break;
    }
}